{
  "name": "oep-client-js",
  "version": "0.0.1",
  "private": true,
  "description": "OEP Probe Tool: a web page that makes a board an Open Embedded Probe, sets it up and keeps it, and hands it to the tools that do the work - with the JavaScript OEP host code it runs on. Not published to npm.",
  "license": "MIT",
  "author": "TANAKA Masayuki",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Embedded-Probe/oep-client-js.git"
  },
  "homepage": "https://open-embedded-probe.github.io/oep-client-js/",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:watch": "node scripts/run-tests.js --watch",
    "build:site": "node scripts/build-site.js",
    "serve": "node scripts/serve.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "check": "npm run test && npm run typecheck",
    "test:browser": "node scripts/check-browser.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "esptool-js": "0.7.1",
    "typescript": "^5.7.0"
  }
}
